<?xml version="1.0" encoding="UTF-8"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="player_vimeo" type="host">player.vimeo.com</value>
                <value id="player_facebook_sdk" type="host">connect.facebook.net</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="player_vimeo" type="host">player.vimeo.com</value>
                <value id="player_facebook" type="host">*.facebook.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="cdninstagram-com" type="host">*.cdninstagram.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
