<?php
/** @var \Magento\Framework\Escaper $escaper */
/** @var \MageSuite\ContentConstructorFrontend\Model\Component\ImageTeaser $viewModel */
$viewModel = $block->getViewModel();
$imageTeaserData = $block->getImageTeaserData();
$slide = $block->getSlide();
$isSvg = $slide->isSvg();

/**
 * If set to true, image will use data-consent-src and data-consent-srcset attributes
 * instead of standard src and srcset attributes, so images will not be loaded by default.
 * Loading such images needs to be handled by a custom script that relies on a consent management.
 */
$isConsentRequired = $block->getIsConsentRequired() ?? false;

$visibilityMediaQuery = $block->getVisibilityMediaQuery();

/**
 * Image properties with support for conditional lazy loading.
 */
$origImageSrc = $escaper->escapeUrl((string) $slide->getSrc());
$hasImage = !empty($origImageSrc);
$placeholderImageSrc = 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';
$imageSrcset = $slide->getSrcSet();

if (empty($imageSrcset) || $isSvg) {
    $imageSrcset = $origImageSrc;
}

$imageAlt = $viewModel->replaceHtmlTagsWithWhiteSpaces((string)$slide->getAlt());
$imageSizes = $isSvg ? '' : $slide->getSizes();
$isSlider = $block->getIsSlider();
$isSliderMobile = $block->getIsSliderMobile();
$fetchPriority = $block->getFetchPriority();
$lazyLoad = $block->getLazyLoad();
$eagerLoad = $block->getEagerLoad();

/**
 * Aspect ratio and sizing
 */
$aspectRatio = $block->getAspectRatio();
$imageWidth = $slide->getWidth();
$imageHeight = $slide->getHeight();

/**
 * Contrast optimizers
 */
$contrastOptimizers = $slide->getOptimizers();
$mirrorImage = $contrastOptimizers['mirror_image'] ?? null;
$imageMimeType = $slide->getMimeType();

/**
 * Video Teaser
 */
$videoTeaserData = $slide->getVideo();
$hasVideoTeaser = !empty($videoTeaserData['url']) && !empty($videoTeaserData['type']);

/**
 * Conditional lazy loading
 */
$isLazyLoaded = $eagerLoad ? false : $lazyLoad;
$imageClass = sprintf(
    'cs-image-teaser__image%s%s',
    $mirrorImage ? ' cs-image-teaser__image--mirror' : '',
    $isLazyLoaded ? ' lazyload' : ''
);
?>

<?php if ($hasImage): ?>
    <picture
        class="cs-image-teaser__picture"
        <?php if ($aspectRatio): ?>
            style="aspect-ratio: <?= $escaper->escapeHtmlAttr((string) $aspectRatio) ?>"
        <?php endif ?>
    >
        <?php if ($hasVideoTeaser): ?>
            <?= $block->getLayout()
                ->createBlock(\MageSuite\ContentConstructorFrontend\Block\Component\ImageTeaser\VideoTeaser::class)
                ->setImageTeaserData($imageTeaserData)
                ->setSlide($slide)
                ->setVideoTeaserData($videoTeaserData)
                ->toHtml();
            ?>
        <?php endif; ?>
        <source
            <?php if ($visibilityMediaQuery): ?>
                media="<?= $escaper->escapeHtmlAttr((string) $visibilityMediaQuery) ?>"
            <?php endif; ?>
            <?php if ($isLazyLoaded): ?>
                srcset="<?= $escaper->escapeHtmlAttr($placeholderImageSrc) ?>"
                <?php if ($isConsentRequired): ?>
                    data-consent-srcset="<?= $escaper->escapeUrl((string) $imageSrcset) ?>"
                <?php else: ?>
                    data-srcset="<?= $escaper->escapeUrl((string) $imageSrcset) ?>"
                <?php endif; ?>
            <?php else: ?>
                <?php if ($isConsentRequired): ?>
                    data-consent-srcset="<?= $escaper->escapeUrl((string) $imageSrcset) ?>"
                <?php else: ?>
                    srcset="<?= $escaper->escapeUrl((string) $imageSrcset) ?>"
                <?php endif; ?>
            <?php endif; ?>

            <?php if ($imageMimeType): ?>
                type="<?= $escaper->escapeHtmlAttr($imageMimeType) ?>"
            <?php endif; ?>
            <?php if ($imageSizes): ?>
                sizes="<?= $escaper->escapeHtmlAttr((string) $imageSizes) ?>"
            <?php endif; ?>
            <?php if ($imageWidth): ?>
                width="<?= $escaper->escapeHtmlAttr((string) $imageWidth) ?>"
            <?php endif; ?>
            <?php if ($imageHeight): ?>
                height="<?= $escaper->escapeHtmlAttr((string) $imageHeight) ?>"
            <?php endif; ?>
        >
        <img
            class="<?= $escaper->escapeHtmlAttr($imageClass) ?>"
            alt="<?= $escaper->escapeHtmlAttr($imageAlt) ?>"
            <?php if (!$imageAlt): ?>
                aria-hidden="true"
            <?php endif ?>

            src="<?= $escaper->escapeHtmlAttr($placeholderImageSrc) ?>"
            <?php if ($isLazyLoaded): ?>
                <?php if ($isConsentRequired): ?>
                    data-consent-src="<?= $escaper->escapeUrl($origImageSrc) ?>"
                    data-consent-srcset="<?= $escaper->escapeUrl((string) $imageSrcset) ?>"
                <?php elseif (!$visibilityMediaQuery): ?>
                    data-src="<?= $escaper->escapeUrl($origImageSrc) ?>"
                    data-srcset="<?= $escaper->escapeUrl((string) $imageSrcset) ?>"
                <?php endif; ?>
            <?php else: ?>
                <?php if ($isConsentRequired): ?>
                    data-consent-src="<?= $escaper->escapeUrl($origImageSrc) ?>"
                    data-consent-srcset="<?= $escaper->escapeUrl((string) $imageSrcset) ?>"
                <?php elseif (!$visibilityMediaQuery): ?>
                    src="<?= $escaper->escapeUrl($origImageSrc) ?>"
                    srcset="<?= $escaper->escapeUrl((string) $imageSrcset) ?>"
                <?php endif; ?>
            <?php endif; ?>
            <?php if ($imageSizes): ?>
                sizes="<?= $escaper->escapeHtmlAttr((string) $imageSizes) ?>"
            <?php endif; ?>
            <?php if ($imageWidth): ?>
                width="<?= $escaper->escapeHtmlAttr((string) $imageWidth) ?>"
            <?php endif; ?>
            <?php if ($imageHeight): ?>
                height="<?= $escaper->escapeHtmlAttr((string) $imageHeight) ?>"
            <?php endif; ?>
            <?php if ($fetchPriority): ?>
                fetchpriority="high"
            <?php endif; ?>
            <?php if ($eagerLoad): ?>
                loading="eager"
            <?php endif; ?>
        >
    </picture>
<?php endif; ?>
