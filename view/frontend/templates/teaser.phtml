<?php
    /**
     * Single teaser template
     *
     * @var $block \Magento\Framework\View\Element\Template
     * @var \Magento\Framework\Escaper $escaper
     */
?>
<?php
    $teaser = $block->getTeaserData();
    $teaserId = $block->getTeaserId();
    $gridClass = $block->getGridClass();
    $brickClass = $block->getBrickClass();
    $buttonModifierClass = $block->getVar('teaser/button_modifier_class', 'MageSuite_ContentConstructorFrontend');

    $teaserBrickClass = $brickClass . ' ' . $brickClass . '--teaser';
    if($teaser['size']['x'] == 2) {
        $teaserBrickClass .= ' ' . $brickClass . '--x2';
    }
    if($teaser['size']['y'] == 2) {
        $teaserBrickClass .= ' ' . $brickClass . '--y2';
    }

    $teaserImageAlt = $teaser['image']['alt'] ?? '';
    $teaserHtmlTag = $block->getHtmlTag() ?? 'div';
?>

<<?= /** @noEscape */ $teaserHtmlTag ?> class="<?= /** @noEscape */ $teaserBrickClass ?>" data-teaser-id="<?= /** @noEscape */ $teaserId ?>">
    <div class="<?= /** @noEscape */ $gridClass ?>__teaser <?= /** @noEscape */ $gridClass ?>__teaser--scheme-<?= /** @noEscape */ $teaser['colorScheme'] ?>">
        <?php if($teaser['href'] != ''): ?>
            <a href="<?= /** @noEscape */ $teaser['href'] ?>" class="<?= /** @noEscape */ $gridClass; ?>__teaser-content-wrapper">
        <?php else: ?>
            <div class="<?= /** @noEscape */ $gridClass; ?>__teaser-content-wrapper">
        <?php endif; ?>

            <figure class="<?= /** @noEscape */ $gridClass; ?>__teaser-figure">
                <?php // @TODO: unify image structure ?>
                <img
                    class="<?= /** @noEscape */ $gridClass; ?>__teaser-image lazyload"
                    src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="
                    data-src="<?= /** @noEscape */ $teaser['image']['src'] ?>"
                    <?php if ($teaser['image']['srcSet']): ?>data-srcset="<?= /** @noEscape */ $teaser['image']['srcSet'] ?>"<?php endif; ?>
                    alt="<?= /** @noEscape */ $teaserImageAlt ?>"
                >
            </figure>
            <div class="<?= /** @noEscape */ $gridClass; ?>__teaser-content <?= /** @noEscape */ $gridClass; ?>__teaser-content--<?= /** @noEscape */ $teaser['displayVariant'] ?>">
                <?php if($teaser['headline'] != '') {
                    $headlineHtml = sprintf('<h4 class="%s__teaser-headline">%s</h4>', $gridClass, $teaser['headline']);
                    echo /** @noEscape */ $headlineHtml;
                }
                if($teaser['subheadline'] != '') {
                    $subheadlineHtml = sprintf('<span class="%s__teaser-subheadline">%s</span>', $gridClass, $teaser['subheadline']);
                    echo /** @noEscape */ $subheadlineHtml;
                }
                if($teaser['paragraph'] != '') {
                    $paragraphHtml = sprintf('<p class="%s__teaser-text">%s</p>', $gridClass, $teaser['paragraph']);
                    echo /** @noEscape */ $paragraphHtml;
                }
                if($teaser['ctaLabel'] != '' && $teaser['href'] != '') {
                    $ctaHtml = sprintf('<span role="button" class="cs-button %s">
                        <span class="cs-button__span">%s</span>
                        <svg class="cs-button__icon"><use xlink:href="#arrow_next"></use></svg>
                    </span>', $escaper->escapeHtmlAttr($buttonModifierClass), $teaser['ctaLabel']);
                    echo /** @noEscape */ $ctaHtml;
                } ?>
            </div>

        <?php if($teaser['href'] != ''): ?>
            </a>
        <?php else: ?>
            </div>
        <?php endif; ?>
    </div>
</<?= /** @noEscape */ $teaserHtmlTag ?>>
